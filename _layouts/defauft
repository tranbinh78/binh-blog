<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>
  {% seo %}
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | relative_url }}">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="{{ site.baseurl | default: '/' }}" class="brand">{{ site.title }}</a>
      <nav class="main-nav">
        <a href="{{ site.baseurl }}/">Home</a>
        <a href="{{ site.baseurl }}/categories/">Categories</a>
        <a href="{{ site.baseurl }}/tags/">Tags</a>
        <a href="{{ site.baseurl }}/archives/">Archives</a>
        <a href="{{ site.baseurl }}/about/">About</a>
        <a href="{{ site.baseurl }}/grammar/">Grammar</a>
      </nav>
    </div>
  </header>

  <main class="site-main wrap">
    {{ content }}
  </main>

  <footer class="site-footer wrap">
    <p>&copy; {{ site.time | date: '%Y' }} {{ site.author.name }}</p>
  </footer>
</body>
</html>
